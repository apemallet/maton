!/data/jobs/*/render/**
!/data/jobs/*/plots/**
/data/jobs/*/progress/checkpoints/
/data/jobs/*/progress/dreamer-*.pkl
/data/jobs/*/progress/resume/replay.*
/data/jobs/*/progress/**/*.tmp

